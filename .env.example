# Anthropic API key — get one at https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# Notion integration token — create one at https://www.notion.so/my-integrations
# Share your Competitor Watchlist database with the integration before running.
NOTION_API_KEY=

# ID of the "Competitor Watchlist" Notion database.
# Run `npm run setup-notion` once to create the database and print this ID.
NOTION_WATCHLIST_DB_ID=

# Parent Notion page ID — only needed for the one-time setup script.
# Copy the page ID from its URL (notion.so/<page-id>) and share the page with your integration.
# You can remove this after running `npm run setup-notion`.
NOTION_PARENT_PAGE_ID=

# Langfuse observability (optional — tracing is disabled if these are absent)
# Get keys at https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
